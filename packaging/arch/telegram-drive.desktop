[Desktop Entry]
Type=Application
Name=Telegram Drive
GenericName=Cloud storage
Comment=Cloud drive that stores your files in your own Telegram account
Exec=/opt/telegram-drive/bin/TelegramDrive %F
Icon=telegram-drive
Terminal=false
Categories=Network;FileTransfer;
Keywords=cloud;drive;telegram;storage;backup;
StartupWMClass=telegram-drive-TelegramDrive
